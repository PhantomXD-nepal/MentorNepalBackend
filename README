# MentorNepal — Backend PRD

**Stack:** Express.js · SQLite3 (better-sqlite3) · better-auth · Custom In-Memory Cache · Daily.co (meetings)

---

## 1. Overview

MentorNepal is a verified-mentor marketplace where Nepali professionals connect for 1:1 mentorship sessions. Mentees browse verified mentors, book 30/60-minute sessions, and join video calls via Daily.co rooms. The backend is a REST API consumed by the Next.js frontend.

---

## 2. Auth — better-auth

Use `better-auth` with the following config:

```ts
import { betterAuth } from 'better-auth'
import { db } from './db' // better-sqlite3 instance

export const auth = betterAuth({
  database: db,
  emailAndPassword: { enabled: true },
  emailVerification: {
    sendVerificationEmail: async (user, url) => {
      // send via Resend / SMTP
    },
    autoSignInAfterVerification: true,
  },
  session: {
    expiresIn: 60 * 60 * 24 * 7, // 7 days
    updateAge: 60 * 60 * 24,
  },
  user: {
    additionalFields: {
      role: { type: 'string', defaultValue: 'mentee' }, // 'mentee' | 'mentor' | 'admin'
      onboardingComplete: { type: 'boolean', defaultValue: false },
    },
  },
})
```

All protected routes use the `requireAuth` middleware that calls `auth.api.getSession()`. Role-gated routes additionally check `session.user.role`.

---

## 3. Database Schema (SQLite3)

### 3.1 `users` (managed by better-auth)

better-auth creates this automatically. Extended with `role` and `onboarding_complete` via `additionalFields`.

### 3.2 `mentor_profiles`

```sql
CREATE TABLE mentor_profiles (
  id              TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
  user_id         TEXT NOT NULL UNIQUE REFERENCES users(id) ON DELETE CASCADE,
  full_name       TEXT NOT NULL,
  headline        TEXT NOT NULL,                  -- "Senior SWE at Leapfrog Technology"
  bio             TEXT NOT NULL,
  avatar_url      TEXT,
  linkedin_url    TEXT,
  location        TEXT DEFAULT 'Kathmandu, Nepal',
  languages       TEXT DEFAULT '["Nepali","English"]',  -- JSON array
  expertise_tags  TEXT NOT NULL,                 -- JSON array: ["Backend","System Design"]
  years_exp       INTEGER NOT NULL,
  session_price   INTEGER DEFAULT 0,             -- NPR, 0 = free
  is_verified     INTEGER DEFAULT 0,             -- 0 | 1
  is_active       INTEGER DEFAULT 1,
  total_sessions  INTEGER DEFAULT 0,
  avg_rating      REAL DEFAULT 0.0,
  review_count    INTEGER DEFAULT 0,
  created_at      TEXT DEFAULT (datetime('now')),
  updated_at      TEXT DEFAULT (datetime('now'))
);
```

### 3.3 `mentee_profiles`

```sql
CREATE TABLE mentee_profiles (
  id              TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
  user_id         TEXT NOT NULL UNIQUE REFERENCES users(id) ON DELETE CASCADE,
  full_name       TEXT NOT NULL,
  bio             TEXT,
  avatar_url      TEXT,
  goals           TEXT,                          -- JSON array: ["Get first job","Switch to ML"]
  career_stage    TEXT,                          -- "student" | "early" | "mid" | "senior"
  interests       TEXT,                          -- JSON array
  created_at      TEXT DEFAULT (datetime('now')),
  updated_at      TEXT DEFAULT (datetime('now'))
);
```

### 3.4 `availability_slots`

```sql
CREATE TABLE availability_slots (
  id          TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
  mentor_id   TEXT NOT NULL REFERENCES mentor_profiles(id) ON DELETE CASCADE,
  day_of_week INTEGER NOT NULL,  -- 0=Sun, 1=Mon ... 6=Sat
  start_time  TEXT NOT NULL,     -- "09:00" (Nepal Time, UTC+5:45)
  end_time    TEXT NOT NULL,     -- "10:00"
  is_active   INTEGER DEFAULT 1,
  UNIQUE(mentor_id, day_of_week, start_time)
);
```

### 3.5 `sessions`

```sql
CREATE TABLE sessions (
  id              TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
  mentor_id       TEXT NOT NULL REFERENCES mentor_profiles(id),
  mentee_id       TEXT NOT NULL REFERENCES mentee_profiles(id),
  scheduled_at    TEXT NOT NULL,              -- ISO8601 UTC
  duration_mins   INTEGER DEFAULT 30,         -- 30 | 60
  status          TEXT DEFAULT 'pending',     -- pending | confirmed | completed | cancelled | no_show
  meeting_url     TEXT,                       -- Daily.co room URL
  daily_room_name TEXT,                       -- for deletion after session
  topic           TEXT,                       -- what mentee wants to discuss
  mentee_note     TEXT,
  mentor_note     TEXT,
  cancelled_by    TEXT,                       -- user_id
  cancel_reason   TEXT,
  created_at      TEXT DEFAULT (datetime('now')),
  updated_at      TEXT DEFAULT (datetime('now'))
);
```

### 3.6 `reviews`

```sql
CREATE TABLE reviews (
  id          TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
  session_id  TEXT NOT NULL UNIQUE REFERENCES sessions(id),
  mentor_id   TEXT NOT NULL REFERENCES mentor_profiles(id),
  mentee_id   TEXT NOT NULL REFERENCES mentee_profiles(id),
  rating      INTEGER NOT NULL CHECK (rating BETWEEN 1 AND 5),
  comment     TEXT,
  is_public   INTEGER DEFAULT 1,
  created_at  TEXT DEFAULT (datetime('now'))
);
```

### 3.7 `verification_requests`

```sql
CREATE TABLE verification_requests (
  id            TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
  mentor_id     TEXT NOT NULL REFERENCES mentor_profiles(id),
  linkedin_url  TEXT NOT NULL,
  documents     TEXT,               -- JSON array of URLs (uploaded proof)
  status        TEXT DEFAULT 'pending',  -- pending | approved | rejected
  admin_note    TEXT,
  reviewed_by   TEXT,               -- admin user_id
  created_at    TEXT DEFAULT (datetime('now')),
  updated_at    TEXT DEFAULT (datetime('now'))
);
```

### 3.8 `notifications`

```sql
CREATE TABLE notifications (
  id          TEXT PRIMARY KEY DEFAULT (lower(hex(randomblob(16)))),
  user_id     TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  type        TEXT NOT NULL,   -- 'session_booked' | 'session_confirmed' | 'session_reminder' | 'review_received'
  title       TEXT NOT NULL,
  body        TEXT NOT NULL,
  data        TEXT,            -- JSON: { sessionId, etc. }
  is_read     INTEGER DEFAULT 0,
  created_at  TEXT DEFAULT (datetime('now'))
);
```

---

## 4. In-Memory Cache

Custom LRU-style cache with TTL. Used for read-heavy, low-mutation data.

```ts
// cache.ts
interface CacheEntry<T> {
  value: T
  expiresAt: number
}

class InMemoryCache {
  private store = new Map<string, CacheEntry<any>>()

  set<T>(key: string, value: T, ttlMs: number) {
    this.store.set(key, { value, expiresAt: Date.now() + ttlMs })
  }

  get<T>(key: string): T | null {
    const entry = this.store.get(key)
    if (!entry) return null
    if (Date.now() > entry.expiresAt) {
      this.store.delete(key)
      return null
    }
    return entry.value as T
  }

  invalidate(pattern: string) {
    for (const key of this.store.keys()) {
      if (key.startsWith(pattern)) this.store.delete(key)
    }
  }
}

export const cache = new InMemoryCache()
```

**Cache keys and TTLs:**

| Key                                          | TTL    | Invalidated on                          |
| -------------------------------------------- | ------ | --------------------------------------- |
| `mentors:list:{page}:{filters}`              | 5 min  | mentor profile update, new verification |
| `mentor:profile:{mentorId}`                  | 10 min | profile update                          |
| `mentor:reviews:{mentorId}:{page}`           | 10 min | new review                              |
| `mentor:availability:{mentorId}:{weekStart}` | 2 min  | slot update, new booking                |
| `stats:platform`                             | 30 min | any session completed                   |

