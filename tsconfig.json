{
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "drizzle.config.ts"],
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "strict": true,
    "noEmitOnError": false,
    "skipLibCheck": true
  }
}
